<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <ImportDirectoryPackagesProps>false</ImportDirectoryPackagesProps>
    <UseSharedCompilation>false</UseSharedCompilation>
    <LoggerSource Condition="'$(LoggerSource)' == ''">../../src/ACUCustomizationUtil/Builders/Log/SerilogBuilder.cs</LoggerSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Harness.cs" />
    <Compile Include="$(LoggerSource)" Link="SerilogBuilder.cs" />
    <Compile Include="../../src/ACUCustomizationUtil/Extensions/StringExtentions.cs" Link="StringExtentions.cs" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" ExcludeAssets="analyzers;build;buildTransitive" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" ExcludeAssets="analyzers;build;buildTransitive" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" ExcludeAssets="analyzers;build;buildTransitive" />
  </ItemGroup>
</Project>
